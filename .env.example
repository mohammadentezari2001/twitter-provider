# =============================================================================
#  tweet-relay-bot — environment configuration
#  Copy to `.env` and fill in real values.  NEVER commit `.env`.
#    cp .env.example .env && chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Telegram  (REQUIRED)
# -----------------------------------------------------------------------------
# From @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Target channel. Either the numeric ID (preferred, starts with -100) or @username.
# Get the numeric ID: forward a channel post to @userinfobot, or see docs/deployment.md step 5.
TELEGRAM_CHANNEL_ID=-1001234567890

# Optional. Public @username of the channel, shown in the footer of every
# published post and used to build nicer "View in channel" links. Leave empty for
# a private channel: the footer then omits the handle rather than inventing one.
# A `@name` TELEGRAM_CHANNEL_ID is used as the username when this is empty.
TELEGRAM_CHANNEL_USERNAME=

# Display name of the channel, shown on the first line of the footer of every
# published post. Example footer:
#     📢 Dovio Twitter
#     @doviotwitter
# Leave empty to show the username alone.
TELEGRAM_CHANNEL_NAME=

# Comma-separated Telegram user IDs allowed to use the bot. Get yours from @userinfobot.
# The FIRST id in the list is bootstrapped as the "owner" role.
ADMIN_USER_IDS=111111111,222222222

# -----------------------------------------------------------------------------
# 2. Datastores  (REQUIRED)
# -----------------------------------------------------------------------------
# Must match the credentials of the `postgres` service in docker-compose.yml.
POSTGRES_DB=tweetrelay
POSTGRES_USER=tweetrelay
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Inside Docker Compose the hostname is the service name (`postgres`).
DATABASE_URL=postgresql+asyncpg://tweetrelay:change-me-to-a-long-random-string@postgres:5432/tweetrelay

# NOT YET USED by this build. Accepted, validated and logged as a startup
# warning, but nothing connects to it: every piece of durable state — the job
# queue, the tweet cache, the publish cooldown, pending previews — lives in
# PostgreSQL. Setting this changes nothing today and the app behaves identically
# with it empty. See README "What this build does not do yet".
REDIS_URL=

# -----------------------------------------------------------------------------
# 3. Tweet retrieval provider
# -----------------------------------------------------------------------------
# syndication   — (DEFAULT) X's own public embed endpoint. No account, no API key,
#                 no third party in the middle. Nothing to configure: leave the
#                 three SYNDICATION_* settings below alone and it works.
# mock          — built-in fixtures. Local development and tests only.
# x_api         — the official X API v2 (https://developer.x.com), which needs a
#                 paid tier for anything beyond a trickle. Needs a Bearer token.
# generic_http  — any authorized third-party API returning the documented JSON
#                 contract (see docs/configuration.md § generic_http).
#
# The default is `syndication` because it is the only real provider that works on
# a fresh install. It is never `mock`: a mock default would let a deployment with
# a missing credential publish fixture text into a real channel and look like it
# was working, which is the worst possible failure for a relay bot.
TWEET_PROVIDER=syndication

# --- Only for TWEET_PROVIDER=syndication -------------------------------------
# Where to ask. There is rarely a reason to change this.
SYNDICATION_URL=https://cdn.syndication.twimg.com/tweet-result

# Optional. The endpoint wants a `token` query parameter derived from the tweet
# ID, and the provider computes it using the formula in X's own embed script.
# That formula is reverse-engineered, so it is the most fragile part of the
# retrieval path. If fetching starts failing, the error message prints a curl
# command; if that curl returns JSON with a `token` in it, paste the working
# value here and it will be used verbatim instead of the computed one.
SYNDICATION_TOKEN=

# --- Only for TWEET_PROVIDER=x_api or generic_http ---------------------------
# x_api        -> your App's "Bearer Token"
# generic_http -> the provider's API key
TWEET_API_KEY=

# Only for generic_http. Example: https://api.example-provider.com/v1
TWEET_API_BASE_URL=

# Only for generic_http. `{tweet_id}` is substituted.
TWEET_API_TWEET_PATH=/tweets/{tweet_id}
# Header used to send TWEET_API_KEY, and an optional value template.
TWEET_API_AUTH_HEADER=Authorization
TWEET_API_AUTH_SCHEME=Bearer
# Dotted path to the tweet object inside the JSON response ("" = document root).
TWEET_API_RESPONSE_ROOT=data

TWEET_API_TIMEOUT=15.0
# Seconds a successfully retrieved tweet payload stays fresh, cached in the
# PostgreSQL `tweets` table. 0 means "always re-fetch" — note that a row is still
# written, because `publications.tweet_id` is a foreign key into it. Deleted and
# protected posts are negatively cached for at least an hour regardless, so a
# dead link is not re-requested on every retry.
TWEET_CACHE_TTL=21600

# -----------------------------------------------------------------------------
# 4. Publishing behaviour
# -----------------------------------------------------------------------------
# Publishing is automatic: an authorized admin sending a tweet URL is the
# approval, and the bot fetches and posts it with no confirmation step. There is
# no AUTO_PUBLISH / REQUIRE_CONFIRMATION switch — those settings are gone.

MAX_CONCURRENT_FETCHES=4
MAX_CONCURRENT_PUBLISHES=2
MAX_RETRIES=5
# Exponential backoff: RETRY_BASE_DELAY * 2**(attempt-1), capped, plus jitter.
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=900.0
# Minimum seconds between two publications. Telegram allows ~20 msg/min per
# channel; 4.0s ≈ 15/min which leaves headroom for media groups.
PUBLISH_COOLDOWN=4.0
# Seconds a worker may hold a job before it is considered crashed and requeued.
JOB_LOCK_TIMEOUT=600
WORKER_POLL_INTERVAL=2.0

# -----------------------------------------------------------------------------
# 5. Media handling
# -----------------------------------------------------------------------------
# Telegram's bot upload ceiling is 50 MB; keep a safety margin.
MEDIA_MAX_SIZE_MB=45
# RESERVED — media is downloaded into a per-publish workspace and removed when
# the publish ends. There is no cross-job media cache in this build.
MEDIA_CACHE_ENABLED=true
MEDIA_CONNECT_TIMEOUT=10.0
MEDIA_DOWNLOAD_TIMEOUT=120.0
MEDIA_TMP_DIR=/app/tmp/media
# Comma-separated hostname allowlist for media downloads (suffix match).
# Empty = allow any PUBLIC host (private/loopback IPs are always blocked).
# Add your provider's CDN host here if it is not one of the defaults.
MEDIA_ALLOWED_HOSTS=pbs.twimg.com,video.twimg.com,abs.twimg.com,ton.twimg.com
# Publish video attachments as playable clips (sendVideo). A tweet carries
# either photos or a single video/GIF, never both, so this adds a message
# rather than changing anything about the photo path. The MP4 rendition is
# downloaded under the same 50 MB bot-upload ceiling as any other file; a
# video that is unavailable or offered only as HLS is skipped, and the admin
# receipt says so. Set false to relay such posts as text instead.
ALLOW_VIDEO=true
# What to do when media cannot be downloaded or uploaded:
#   text_link  — publish text only (the source link is never rendered)
#   skip_media — same effect as text_link in this build
#   fail       — fail the job so you can retry it later
MEDIA_FAILURE_MODE=text_link
# When the rendered post exceeds Telegram's 1024-char caption limit:
#   text_first  — send the text message, then the media
#   media_first — send the media (uncaptioned), then the text
#   truncate    — keep one message and shorten the tweet text with an ellipsis
LONG_CAPTION_MODE=text_first

# -----------------------------------------------------------------------------
# 6. Post template
# -----------------------------------------------------------------------------
# A published post is: the author's display name, the tweet text, its photos,
# and the channel footer below. The author's @handle, the original post's URL and
# its publication time are never rendered.
#
# minimal | rich | custom
POST_TEMPLATE=rich
# RESERVED — accepted, but the shipped templates do not render an avatar.
SHOW_AUTHOR_AVATAR=true
INCLUDE_SIGNATURE=false

# Optional free text. Supports Telegram HTML (<b> <i> <a href> <code> ...).
TEMPLATE_HEADER=
TEMPLATE_FOOTER=
TEMPLATE_SIGNATURE=
# {name} is substituted. {username}, {handle} and {id} still parse but render
# empty — the @handle is no longer part of a post. An unparseable value falls
# back to "{name}" with a warning rather than failing the publish.
TEMPLATE_AUTHOR_FORMAT={name}
TEMPLATE_EMOJI_AUTHOR=🐦
# Prefix for the channel footer's name line (see TELEGRAM_CHANNEL_NAME).
TEMPLATE_EMOJI_CHANNEL=📢
# Only used when POST_TEMPLATE=custom. Telegram HTML with a required {text}
# placeholder, split around it so the post text can still be truncated safely.
# Also supports {author} {header} {footer} {signature}. `{link}` and `{time}`
# remain accepted but render empty, so an older template degrades gracefully.
TEMPLATE_CUSTOM=

# -----------------------------------------------------------------------------
# 7. Runtime / observability
# -----------------------------------------------------------------------------
# bot | worker | all   (docker-compose runs `bot` and `worker` separately)
RUN_MODE=all
LOG_LEVEL=INFO
# json (production, machine-readable) | console (human-readable)
LOG_FORMAT=json
LOG_DIR=/app/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7
TIMEZONE=UTC
# Touched periodically; the Docker healthcheck fails if it goes stale.
# docker-compose.yml overrides this per service (heartbeat-bot / heartbeat-worker)
# so a live bot cannot mask a wedged worker — the shared app-run volume would
# otherwise make both containers look healthy as long as either one was alive.
HEARTBEAT_FILE=/app/run/heartbeat
HEARTBEAT_MAX_AGE=120

# RESERVED — one language (English) ships in this build; every user-facing string
# is already centralised in app/bot/messages.py, which is the expensive half of
# adding a second one.
LOCALE=en

# DANGEROUS — only for local testing against a LAN/localhost media server.
ALLOW_PRIVATE_MEDIA_HOSTS=false
